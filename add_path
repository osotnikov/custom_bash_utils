#!/usr/bin/env bash

UPDATE_SUDO=1
NEW_ENTRY=""

# 1. Parse arguments for --no-sudo flag
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-sudo)
            UPDATE_SUDO=0
            shift
            ;;
        *)
            if [ -z "$NEW_ENTRY" ]; then
                NEW_ENTRY="$1"
            fi
            shift
            ;;
    esac
done

# Check for missing argument
if [ -z "$NEW_ENTRY" ]; then
    echo "Usage: add_path [--no-sudo] /path/to/directory"
    exit 1
fi

# Check if directory actually exists
if [ ! -d "$NEW_ENTRY" ]; then
    echo "Error: '$NEW_ENTRY' is not a valid directory."
    exit 1
fi

# Strip trailing slashes for clean PATH comparison
NEW_ENTRY="${NEW_ENTRY%/}"

# 2. Check and update current shell PATH session
if [[ ":$PATH:" == *":$NEW_ENTRY:"* ]]; then
    echo "Notice: '$NEW_ENTRY' is already in current PATH."
else
    export PATH="$PATH:$NEW_ENTRY"
    echo "Success: Added '$NEW_ENTRY' to PATH for this session."
fi

# 3. Read and update /etc/environment (Always runs)
if [ ! -f /etc/environment ]; then
    echo "Error: /etc/environment file not found."
    exit 1
fi

# Read current PATH string from /etc/environment
CURRENT_PATH=$(grep -E '^PATH=' /etc/environment | sed -E 's/^PATH="?([^"]*)"?$/\1/')

if [[ ":$CURRENT_PATH:" == *":$NEW_ENTRY:"* ]]; then
    echo "Notice: '$NEW_ENTRY' is already present in /etc/environment."
else
    echo "Updating system PATH in /etc/environment..."
    NEW_PATH="${CURRENT_PATH}:${NEW_ENTRY}"
    
    # Safely update the PATH line in /etc/environment
    if sudo sed -i "s|^PATH=.*|PATH=\"${NEW_PATH}\"|" /etc/environment; then
        echo "Success: Added '$NEW_ENTRY' to /etc/environment."
    else
        echo "Error: Failed to write to /etc/environment."
        exit 1
    fi
fi

# 4. Update sudo secure_path via visudo if UPDATE_SUDO flag is active
if [ "$UPDATE_SUDO" -eq 1 ]; then
    echo "Checking sudo secure_path..."

    # Query current sudo secure_path
    SUDO_PATH=$(sudo sudo -V 2>/dev/null | grep -i 'Value for ANY "secure_path"' | sed -E 's/.*:[[:space:]]*//')

    # Fallback to standard system directories if secure_path wasn't found
    if [ -z "$SUDO_PATH" ]; then
        SUDO_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    fi

    if [[ ":$SUDO_PATH:" == *":$NEW_ENTRY:"* ]]; then
        echo "Notice: '$NEW_ENTRY' is already present in sudo secure_path."
    else
        echo "Updating sudo secure_path in /etc/sudoers..."
        NEW_SUDO_PATH="${SUDO_PATH}:${NEW_ENTRY}"

        # Create temporary file to safely modify sudoers
        TMP_SUDOERS=$(mktemp)
        sudo cp /etc/sudoers "$TMP_SUDOERS"

        if grep -q -E '^\s*Defaults\s+secure_path=' "$TMP_SUDOERS"; then
            sudo sed -i -E "s|^\s*Defaults\s+secure_path=.*|Defaults    secure_path=\"${NEW_SUDO_PATH}\"|" "$TMP_SUDOERS"
        else
            echo "Defaults    secure_path=\"${NEW_SUDO_PATH}\"" | sudo tee -a "$TMP_SUDOERS" > /dev/null
        fi

        # Validate syntax using visudo before committing changes to /etc/sudoers
        if sudo visudo -cf "$TMP_SUDOERS" >/dev/null 2>&1; then
            sudo cp "$TMP_SUDOERS" /etc/sudoers
            echo "Success: Added '$NEW_ENTRY' to sudo secure_path."
        else
            echo "Error: visudo syntax check failed. /etc/sudoers was not modified."
            rm -f "$TMP_SUDOERS"
            exit 1
        fi

        rm -f "$TMP_SUDOERS"
    fi
fi
