#!/usr/bin/env bash

# Directories
SRC_DIR="$HOME/.local/src"
BIN_DIR="$HOME/.local/bin"

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

mkdir -p "$BIN_DIR"

if [ ! -d "$SRC_DIR" ]; then
    echo -e "${RED}Error:${NC} Source directory '$SRC_DIR' does not exist."
    exit 1
fi

echo "Checking for script name collisions..."

declare -A SEEN_SCRIPTS
HAS_COLLISION=0

# Step 1: Collision Detection across your subfolders
while IFS= read -r script_path; do
    script_name=$(basename "$script_path")
    
    # Ignore sync-bin itself if stored inside src/
    [ "$script_name" == "sync_bin" ] && continue

    if [[ -n "${SEEN_SCRIPTS[$script_name]}" ]]; then
        echo -e "${RED}[COLLISION ERROR]${NC} Duplicate script name '$script_name' found:"
        echo "  - ${SEEN_SCRIPTS[$script_name]}"
        echo "  - $script_path"
        HAS_COLLISION=1
    else
        SEEN_SCRIPTS["$script_name"]="$script_path"
    fi
done < <(find "$SRC_DIR" -type f -executable)

# Abort early if duplicate names exist in your subfolders
if [ "$HAS_COLLISION" -eq 1 ]; then
    echo -e "${RED}Aborting symlink creation due to collisions.${NC}"
    exit 1
fi

echo "No internal collisions found. Syncing symlinks to $BIN_DIR..."

# Step 2: System binary shadow check & Symlink Creation
for script_name in "${!SEEN_SCRIPTS[@]}"; do
    target_path="${SEEN_SCRIPTS[$script_name]}"
    link_path="$BIN_DIR/$script_name"

    # Check if the name conflicts with an existing command elsewhere in PATH
    existing_binary=$(command -v "$script_name" 2>/dev/null)
    if [ -n "$existing_binary" ] && [ "$existing_binary" != "$link_path" ]; then
        echo -e "${YELLOW}[WARNING]${NC} '$script_name' shadows system command at $existing_binary"
    fi

    # Create or update symlink
    if [ ! -L "$link_path" ] || [ "$(readlink -f "$link_path")" != "$target_path" ]; then
        ln -sf "$target_path" "$link_path"
        echo -e "${GREEN}[LINKED]${NC} $script_name -> $target_path"
    fi
done

# Step 3: Remove dead/broken symlinks in ~/.local/bin pointing to src/
for link in "$BIN_DIR"/*; do
    [ -L "$link" ] || continue
    target=$(readlink -f "$link")
    
    # If the link points to something inside SRC_DIR that no longer exists
    if [[ "$target" == "$SRC_DIR"* ]] && [ ! -e "$target" ]; then
        rm "$link"
        echo -e "${RED}[REMOVED BROKEN LINK]${NC} $(basename "$link")"
    fi
done

echo "Sync complete!"
